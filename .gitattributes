# Line endings are a deployment concern, not a cosmetic one.
#
# core.autocrlf=true is common on Windows clones, and a CRLF shebang line makes the kernel fail to
# find the interpreter ("bad interpreter: /usr/bin/env bash^M"), which would break every script in
# the artifact on the target host. Scripts therefore stay LF no matter who checks them out.
*.sh text eol=lf
*.env.example text eol=lf
mail-server.service text eol=lf

*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.js text eol=lf
Dockerfile text eol=lf
